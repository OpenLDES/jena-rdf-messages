# Code style of the OpenLDES Java repositories (Linked-Data-Interactions, LDESServer): tabs in Java files,
# two spaces in XML, YAML and Markdown.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_style = tab
indent_size = 4
max_line_length = 120

[*.{xml,yml,yaml,json,bs,ttl,trig,nq,nt}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
